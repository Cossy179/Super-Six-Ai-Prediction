# Copy to .env (never commit .env).
POSTGRES_USER=super6
POSTGRES_PASSWORD=change-me
POSTGRES_DB=super6

# Without Docker, the CLI defaults to SQLite at data/super6.db. To use PostgreSQL:
# SUPER6_DATABASE_URL=postgresql+psycopg://super6:change-me@localhost:5432/super6
# SUPER6_DATA_DIR=data
# SUPER6_REPORTS_DIR=reports

# Optional: post cycle warnings/errors to a Slack or Discord incoming webhook.
# SUPER6_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# REST API (`super6 serve`, or `docker compose up -d api`).
# Admin endpoints (import, forecast, confirm, lock, settle) are OFF unless this is set.
# Generate a value with `super6 admin-token`; at least 24 characters.
# SUPER6_ADMIN_TOKEN=
# Browser origins allowed to call the API directly, comma-separated (default: none).
# SUPER6_CORS_ORIGINS=http://localhost:3000
